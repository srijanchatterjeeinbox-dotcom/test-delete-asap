PORT=3000
ADMIN_PASSWORD=change-this-password
# AI Integration (Gemini or Anthropic; dashboard runs in local demo mode without either)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Anthropic API integration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# WhatsApp via Baileys (unofficial integration; use responsibly and follow WhatsApp terms)
ENABLE_WHATSAPP=false
